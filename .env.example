# ============================================
# SECURITY WARNING - CHANGE ALL DEFAULT VALUES!
# ============================================
# This is a template file. Copy to .env and replace with your actual credentials.
# Usage: cp .env.example .env
#        Then edit .env with your real values
#
# Note: duplicate keys are last-wins (python-dotenv), so keep each key listed
# exactly once — a second occurrence silently overrides the first.

# Local development (without Docker) - set PYTHONPATH so imports resolve.
# Application code lives in src/, importable as `app.*`.
# PYTHONPATH=src

# ============================================
# Database Configuration
# ============================================
# IMPORTANT: Change 'admin' to a strong password in production!
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
POSTGRES_DB=rag_db
# Only needed outside Docker; compose sets these per service.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================================
# API Keys (REQUIRED - Get from respective services)
# ============================================
# Get your Gemini API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Optional: Logfire for monitoring (https://logfire.pydantic.dev/)
LOGFIRE_WRITE_TOKEN=your-logfire-write-token-or-leave-empty
LOGFIRE_READ_TOKEN=your-logfire-read-token-or-leave-empty

# ============================================
# Ollama (Local LLM - runs on host, accessed via host.docker.internal)
# ============================================
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=deepseek-r1:1.5b
OLLAMA_VLM_MODEL=qwen3.5:0.8b

# ============================================
# LLM & Logging
# ============================================
# Used by the Gemini answer backend (retrieval/llm_operations.py).
GEMINI_MODEL=gemini-2.5-flash
LOG_LEVEL=INFO

# ============================================
# Optional: pgAdmin (Database UI)
# ============================================
PGADMIN_EMAIL=admin@rag.local
PGADMIN_PASSWORD=CHANGE_THIS_PGADMIN_PASSWORD

# ============================================
# Celery & Frontend Access Control
# ============================================
# Shared password required by the web forms; leave blank to disable
APP_ACCESS_PASSWORD=
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Uploads and batch ingestion run on separate queues so a directory scan
# cannot starve interactive uploads.
CELERY_UPLOAD_QUEUE=upload
CELERY_INGESTION_QUEUE=ingestion

# ============================================
# Retrieval & Embedding
# ============================================
DEFAULT_TABLE_NAME=document_chunks
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ============================================
# Ingestion pipeline settings
# ============================================
INPUT_RAW_DIR=input/raw
INGESTION_MAX_ATTEMPTS=2
INGESTION_CLAIM_TIMEOUT_MINUTES=30
DEFAULT_CHUNK_SIZE=512
DEFAULT_PARSE_BACKEND=ollama
# PDF parser backend: "ollama" (Docling + Ollama VLM) or "gemini-docling".
PDF_PARSER_BACKEND=ollama

# Inspectable pipeline artifacts. The DB stays the source of truth; these are
# gitignored dumps so parse output and chunk boundaries can be read on disk.
# Set PERSIST_INGESTION_ARTIFACTS=false to skip writing them.
PARSED_DIR=data/parsed
CHUNKS_DIR=data/chunks
PERSIST_INGESTION_ARTIFACTS=true

# ============================================
# Graph & Entity Extraction (NOT WIRED IN)
# ============================================
# The graph feature lives in src/app/graph/ but nothing in the running app
# imports it and no /graph route is served, so none of the settings below have
# any effect today. AppSettings uses extra='ignore', so they are harmless to
# keep. They only take effect if you mount graph_routes.router and apply
# deploy/migrations/optional/001_create_graph_tables.sql; see
# src/app/config/graph_config.py for the full list.
# (tests/unit/test_graph_not_wired.py asserts the feature stays disconnected.)

# Entity Extraction
ENTITY_CONFIDENCE_THRESHOLD=0.6
ENABLE_ENTITY_EXTRACTION=true
MAX_ENTITIES_PER_CHUNK=50

# Relationship Extraction
RELATIONSHIP_CONFIDENCE_THRESHOLD=0.6
MAX_RELATIONSHIPS_PER_CHUNK=100

# Graph Algorithms
DEFAULT_MAX_HOPS=2

# Entity Embedding Model
ENTITY_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ENTITY_EMBEDDING_DIMENSION=384

# Batch Processing
BATCH_SIZE=10
ENABLE_PARALLEL_EXTRACTION=true
ENABLE_ENTITY_CACHING=true

# Async extraction queue
USE_CELERY_FOR_EXTRACTION=true

# ============================================
# Langfuse (optional LLM observability)
# ============================================
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=changeme-use-a-real-secret-in-prod
LANGFUSE_SALT=changeme-use-a-real-salt-in-prod
LANGFUSE_INIT_ORG_ID=rag-org
LANGFUSE_INIT_PROJECT_ID=rag-project
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_INIT_USER_NAME=
