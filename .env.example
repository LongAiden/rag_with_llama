# ============================================
# SECURITY WARNING - CHANGE ALL DEFAULT VALUES!
# ============================================
# This is a template file. Copy to .env and replace with your actual credentials.
# Usage: cp .env.example .env
#        Then edit .env with your real values
#
# Note: duplicate keys are last-wins (python-dotenv), so keep each key listed
# exactly once — a second occurrence silently overrides the first.

# Local development (without Docker) - set PYTHONPATH so imports resolve.
# Application code lives in src/, importable as `app.*`.
# PYTHONPATH=src

# ============================================
# Database Configuration
# ============================================
# IMPORTANT: Change 'admin' to a strong password in production!
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
POSTGRES_DB=rag_db
# Only needed outside Docker; compose sets these per service.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================================
# API Keys (REQUIRED - Get from respective services)
# ============================================
# Get your Gemini API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Optional: Logfire for monitoring (https://logfire.pydantic.dev/)
LOGFIRE_WRITE_TOKEN=your-logfire-write-token-or-leave-empty
LOGFIRE_READ_TOKEN=your-logfire-read-token-or-leave-empty

# ============================================
# Ollama (Local LLM - runs on host, accessed via host.docker.internal)
# ============================================
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=deepseek-r1:1.5b
OLLAMA_VLM_MODEL=qwen3.5:0.8b

# ============================================
# LLM & Logging
# ============================================
# Used by the Gemini answer backend (retrieval/llm_operations.py).
GEMINI_MODEL=gemini-2.5-flash
LOG_LEVEL=INFO

# ============================================
# Optional: pgAdmin (Database UI)
# ============================================
PGADMIN_EMAIL=admin@rag.local
PGADMIN_PASSWORD=CHANGE_THIS_PGADMIN_PASSWORD

# ============================================
# Celery & Frontend Access Control
# ============================================
# Shared password required by the web forms; leave blank to disable
APP_ACCESS_PASSWORD=
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Uploads and batch ingestion run on separate queues so a directory scan
# cannot starve interactive uploads.
CELERY_UPLOAD_QUEUE=upload
CELERY_INGESTION_QUEUE=ingestion

# ============================================
# Retrieval & Embedding
# ============================================
DEFAULT_TABLE_NAME=document_chunks
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ============================================
# Ingestion pipeline settings
# ============================================
INPUT_RAW_DIR=data/input/raw
INGESTION_MAX_ATTEMPTS=2
# Must exceed the worst-case parse. A 500-page PDF takes ~60 minutes; at the old
# default of 30 the 6-hourly recovery sweep declared live parses stale and
# re-dispatched a second conversion of the same document.
INGESTION_CLAIM_TIMEOUT_MINUTES=180
DEFAULT_CHUNK_SIZE=512
DEFAULT_PARSE_BACKEND=ollama
# PDF parser backend: "ollama" (Docling + Ollama VLM) or "gemini-docling".
PDF_PARSER_BACKEND=ollama

# PDF parse tuning. These values reproduce the previously hardcoded defaults, so
# changing nothing here changes nothing. They exist so the CPU/thread and
# VLM-concurrency experiments in
# docs/20260804_ingestion_performance_investigation.md are env changes.
#   DOCLING_NUM_THREADS      — docling's AcceleratorOptions thread count. Raising
#                              it does nothing unless the container's `cpus:`
#                              limit is raised too, and vice versa.
#   DOCLING_PAGE_BATCH_SIZE  — pages per converter.convert() call. Docling holds
#                              a rendered image for every page in the batch until
#                              the batch is released, so this sets the parse's
#                              working set: ~5.2MB/page at VLM_IMAGES_SCALE=2.0,
#                              i.e. ~208MB at 40. It does NOT by itself bound
#                              peak RSS — see MALLOC_ARENA_MAX in
#                              docker-compose.yml.
#   VLM_CONCURRENCY          — parallel VLM calls. 1 when Ollama is on the same
#                              host: it serializes on one GPU, and measured on an
#                              M1 it goes 3.87s/call at 1, 4.93s at 2, 20.62s at
#                              4. Raise it only if Ollama is on another machine.
DOCLING_NUM_THREADS=4
DOCLING_PAGE_BATCH_SIZE=40
VLM_CONCURRENCY=1

# VLM behaviour. Both defaults are measured, not guessed — see
# docs/20260804_ingestion_performance_investigation.md (F14/F16).
#
# OLLAMA_VLM_THINK — qwen3.5 is a reasoning model and Ollama defaults thinking
#   ON, which costs ~87s per call against ~2.3s without, and the reasoning is
#   discarded unread (it arrives in a separate `thinking` field). This is the API
#   equivalent of typing `/set nothink` in `ollama run`; appending `/no_think` to
#   the prompt is a Qwen3 convention and has no effect on qwen3.5.
#
# VLM_TABLES — false sends every table to docling's TableFormer instead of the
#   VLM. A 0.8B model cannot read tables: on bert.pdf the 13-column GLUE table
#   came back with headers "I, II, III, IV…", a small table came back with
#   invented rows, and with thinking on tables returned nothing at all. Set true
#   to restore the old behaviour of routing complex tables (>8 rows AND >6 cols)
#   to the VLM — worth doing only with a substantially larger vision model.
OLLAMA_VLM_THINK=false
VLM_TABLES=false

# OLLAMA_VLM_TEMPERATURE / OLLAMA_VLM_NUM_PREDICT — VLM latency is pure
#   decode: prefill is ~206 tokens in 0.26s whatever the crop size, then
#   eval_duration is the rest at ~35 tok/s on an M1. Elapsed IS the output
#   length, and Ollama's defaults (temperature 0.8, num_predict -1) leave it
#   unbounded — the same 218x54px equation strip came back as 22 tokens in
#   1.55s and as 342 tokens of invented flowchart in 10.94s on consecutive
#   identical requests, and the worst call of a 191-call run took 93.3s
#   (~3200 tokens, i.e. running to the 4096 context). Greedy decoding gives
#   22-35 tokens and transcribes the crop. num_predict is the ceiling for
#   the tail, not the lever; raise it if you see `done=length` in the logs.
#
# VLM_IMAGES_SCALE — page render resolution, 72 * scale DPI. Docling renders
#   page images at this scale and every VLM crop is cut out of one, so it
#   decides whether the model can read the figure at all. It was pinned at
#   0.6 (43 DPI — an 8pt glyph is 5px tall) with no way to change it, and the
#   model confabulated rather than reporting it could not read: over a
#   504-page run output length was INVERSELY correlated with crop area, and a
#   full-width screenshot delivered as 218x96px came back as an invented
#   ID/Name/Department/Salary table repeated six times until truncation.
#   2.0 = 144 DPI. Costs ~290MB per 50-page batch and ~+0.3s/call of prefill.
#
# VLM_MIN_IMAGE_SHORT_PT — skip any picture whose short side is under this,
#   in POINTS (1/72in) so it does not silently change meaning when
#   VLM_IMAGES_SCALE moves. The existing 150px rule needs BOTH dimensions
#   small, so it only ever caught square icons: 113 of 191 calls in a
#   504-page run were full-column strips below this floor — horizontal rules,
#   equation lines, header bands — which consumed 60% of the VLM budget
#   producing hallucinated descriptions that then get embedded and retrieved.
#   107pt is ~1.48in, which every real figure clears; it reproduces the old
#   64px-at-scale-0.6 gate exactly. 0 disables the rule.
OLLAMA_VLM_TEMPERATURE=0.0
OLLAMA_VLM_NUM_PREDICT=384
VLM_IMAGES_SCALE=2.0
VLM_MIN_IMAGE_SHORT_PT=107

# The runtime image ships without a C++ compiler, so a downstream torch.compile
# path crashes with InvalidCxxCompiler. Nothing in this repo calls torch.compile;
# forcing eager execution removes the crash at no cost.
TORCHDYNAMO_DISABLE=1

# Inspectable pipeline artifacts. The DB stays the source of truth; these are
# gitignored dumps so parse output and chunk boundaries can be read on disk.
# Set PERSIST_INGESTION_ARTIFACTS=false to skip writing them.
PARSED_DIR=data/parsed
CHUNKS_DIR=data/chunks
PERSIST_INGESTION_ARTIFACTS=true

# ============================================
# Graph & Entity Extraction (NOT WIRED IN)
# ============================================
# The graph feature lives in src/app/graph/ but nothing in the running app
# imports it and no /graph route is served, so none of the settings below have
# any effect today. AppSettings uses extra='ignore', so they are harmless to
# keep. They only take effect if you mount graph_routes.router and apply
# deploy/migrations/optional/001_create_graph_tables.sql; see
# src/app/config/graph_config.py for the full list.
# (tests/unit/test_graph_not_wired.py asserts the feature stays disconnected.)

# Entity Extraction
ENTITY_CONFIDENCE_THRESHOLD=0.6
ENABLE_ENTITY_EXTRACTION=true
MAX_ENTITIES_PER_CHUNK=50

# Relationship Extraction
RELATIONSHIP_CONFIDENCE_THRESHOLD=0.6
MAX_RELATIONSHIPS_PER_CHUNK=100

# Graph Algorithms
DEFAULT_MAX_HOPS=2

# Entity Embedding Model
ENTITY_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ENTITY_EMBEDDING_DIMENSION=384

# Batch Processing
BATCH_SIZE=10
ENABLE_PARALLEL_EXTRACTION=true
ENABLE_ENTITY_CACHING=true

# Async extraction queue
USE_CELERY_FOR_EXTRACTION=true

# ============================================
# Langfuse (optional LLM observability)
# ============================================
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=changeme-use-a-real-secret-in-prod
LANGFUSE_SALT=changeme-use-a-real-salt-in-prod
LANGFUSE_INIT_ORG_ID=rag-org
LANGFUSE_INIT_PROJECT_ID=rag-project
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_INIT_USER_NAME=
