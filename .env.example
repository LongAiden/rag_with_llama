# ============================================
# SECURITY WARNING - CHANGE ALL DEFAULT VALUES!
# Copy to .env and replace with real credentials: cp .env.example .env
# Duplicate keys are last-wins (python-dotenv) — keep each key listed once.
# ============================================

# Local dev (no Docker): set so `app.*` resolves (code lives in src/).
# PYTHONPATH=src

# ============================================
# Database Configuration
# ============================================
# Change the password in production!
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
POSTGRES_DB=rag_db
# Only needed outside Docker; compose sets these per service.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================================
# API Keys (REQUIRED)
# ============================================
# https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here
# Optional — https://logfire.pydantic.dev/
LOGFIRE_WRITE_TOKEN=your-logfire-write-token-or-leave-empty
LOGFIRE_READ_TOKEN=your-logfire-read-token-or-leave-empty

# ============================================
# Ollama (Local LLM — runs on host, accessed via host.docker.internal)
# ============================================
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=deepseek-r1:1.5b
OLLAMA_VLM_MODEL=qwen3.5:0.8b

# ============================================
# LLM & Logging
# ============================================
# Used by the Gemini answer backend (retrieval/llm_operations.py).
GEMINI_MODEL=gemini-2.5-flash
LOG_LEVEL=INFO

# ============================================
# pgAdmin (optional Database UI)
# ============================================
PGADMIN_EMAIL=admin@rag.local
PGADMIN_PASSWORD=CHANGE_THIS_PGADMIN_PASSWORD

# ============================================
# Celery & Frontend Access Control
# ============================================
# Shared password for web forms; blank disables.
APP_ACCESS_PASSWORD=
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Separate queues so batch scans can't starve interactive uploads.
CELERY_UPLOAD_QUEUE=upload
CELERY_INGESTION_QUEUE=ingestion

# ============================================
# Retrieval & Reranking
# ============================================
DEFAULT_TABLE_NAME=document_chunks
# Cross-encoder. MiniLM-L-6 (6 layers) default; TinyBERT-L-2-v2 is ~2-3× faster
# on CPU at a small quality cost — requires rebuild to bake into image.
# See docs/plans/20260818_retrieval_speed_vector_rerank.md.
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Cross-encoder input truncation (tokens). 512 default → quadratic attention;
# 256 halves per-pair cost while still scoring every candidate.
RERANK_MAX_LENGTH=256
# Candidates pgvector returns before reranking. Lowering halves cross-encoder
# work but is a recall tradeoff — chunks below the cutoff can't be rescued.
VECTOR_SEARCH_LIMIT=20
# Final top-k after reranking.
RERANK_TOP_K=5
# Eagerly load cross-encoder at startup so first /query isn't penalised.
PRELOAD_RERANKER=true

# ============================================
# Ingestion pipeline
# ============================================
INPUT_RAW_DIR=data/input/raw
INGESTION_MAX_ATTEMPTS=2
# Must exceed worst-case parse (~60min for 500 pages); too low and the recovery
# sweep re-dispatches live parses.
INGESTION_CLAIM_TIMEOUT_MINUTES=180
DEFAULT_CHUNK_SIZE=512
DEFAULT_PARSE_BACKEND=ollama
# "ollama" (Docling + Ollama VLM) or "gemini-docling" (Docling + Gemini).
PDF_PARSER_BACKEND=ollama

# PDF parse tuning — see docs/20260804_ingestion_performance_investigation.md.
#   DOCLING_NUM_THREADS    — must match the container's `cpus:` limit.
#   DOCLING_PAGE_BATCH_SIZE — sets parse working set (~5.2MB/page); does NOT
#                            bound peak RSS (see MALLOC_ARENA_MAX in compose).
#   VLM_CONCURRENCY        — 1 when Ollama is on the same host (GPU-serialised).
DOCLING_NUM_THREADS=4
DOCLING_PAGE_BATCH_SIZE=40
VLM_CONCURRENCY=1

# VLM behaviour — both defaults measured, see investigation doc (F14/F16).
#   OLLAMA_VLM_THINK — false: qwen3.5 thinking costs ~87s/call vs ~2.3s, unread.
#   VLM_TABLES       — false: a 0.8B VLM can't read tables; routed to TableFormer.
OLLAMA_VLM_THINK=false
VLM_TABLES=false

# VLM decode tuning — see investigation doc.
#   TEMPERATURE — greedy (0.0) transcribes; Ollama's 0.8 default confabulates.
#   NUM_PREDICT — tail ceiling; raise if you see `done=length` in logs.
#   IMAGES_SCALE — page render DPI = 72*scale; 2.0 lets the model read figures.
#   MIN_IMAGE_SHORT_PT — skip strips below this (points, scale-independent);
#                        0 disables.
OLLAMA_VLM_TEMPERATURE=0.0
OLLAMA_VLM_NUM_PREDICT=384
VLM_IMAGES_SCALE=2.0
VLM_MIN_IMAGE_SHORT_PT=107

# Runtime image has no C++ compiler; nothing here calls torch.compile, so eager
# is free and avoids InvalidCxxCompiler.
TORCHDYNAMO_DISABLE=1

# OpenMP thread cap for the app container. Keep equal to the app service
# `limits.cpus`; 6 threads against a 1.0 quota thrash. Compose defaults this
# to 1 on the app service only — this var is the override knob.
APP_OMP_NUM_THREADS=1

# Inspectable pipeline artifacts (gitignored dumps; DB stays source of truth).
PARSED_DIR=data/parsed
CHUNKS_DIR=data/chunks
PERSIST_INGESTION_ARTIFACTS=true

# Math/symbol preservation. true keeps ∑ ∫ ∇ α ≤ ² ₁ € in text so the LLM can
# reproduce them; false restores legacy ASCII transliteration. Requires
# re-ingestion to take effect.
PRESERVE_MATH_NOTATION=true

# ============================================
# Graph & Entity Extraction (NOT WIRED IN)
# ============================================
# src/app/graph/ exists but nothing imports it and no /graph route is served.
# These are inert today (AppSettings extra='ignore'). To activate: mount
# graph_routes.router, apply deploy/migrations/optional/001_create_graph_tables.sql.
# See src/app/config/graph_config.py. (tests/unit/test_graph_not_wired.py guards.)

ENTITY_CONFIDENCE_THRESHOLD=0.6
ENABLE_ENTITY_EXTRACTION=true
MAX_ENTITIES_PER_CHUNK=50
RELATIONSHIP_CONFIDENCE_THRESHOLD=0.6
MAX_RELATIONSHIPS_PER_CHUNK=100
DEFAULT_MAX_HOPS=2
ENTITY_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ENTITY_EMBEDDING_DIMENSION=384
BATCH_SIZE=10
ENABLE_PARALLEL_EXTRACTION=true
ENABLE_ENTITY_CACHING=true
USE_CELERY_FOR_EXTRACTION=true

# ============================================
# Langfuse (optional LLM observability)
# ============================================
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=changeme-use-a-real-secret-in-prod
LANGFUSE_SALT=changeme-use-a-real-salt-in-prod
LANGFUSE_INIT_ORG_ID=rag-org
LANGFUSE_INIT_PROJECT_ID=rag-project
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_INIT_USER_NAME=
